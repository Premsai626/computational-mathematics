# ==============================================================================
# ChemicalMix — Environment Configuration (.env.example)
# ==============================================================================

# Server Port (Render sets this dynamically via the PORT environment variable)
PORT=5000

# Environment mode: 'production' or 'development'
FLASK_ENV=production

# Cross-Origin Resource Sharing (CORS)
# Allowed origins for API calls (comma-separated list, or '*' to allow any origin)
CORS_ALLOWED_ORIGINS=*

# Optional: Set this in Render Static Site environment variables if deploying
# the frontend as a separate Render Static Site.
# Leave empty when deploying as a single unified Render Web Service.
BACKEND_URL=https://chemicalmix-backend.onrender.com
